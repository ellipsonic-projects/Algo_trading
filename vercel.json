{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix algo-trading ci",
  "buildCommand": "npm --prefix algo-trading run build",
  "outputDirectory": "algo-trading/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
